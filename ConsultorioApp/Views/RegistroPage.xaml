<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ConsultorioApp.ViewModels"
             x:DataType="viewmodels:RegistroViewModel"
             x:Class="ConsultorioApp.Views.RegistroPage"
             Title="Registrar Usuario">
       
    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="40" VerticalOptions="Center">
               
            <Image Source="logo.png"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Campo: Nombre de usuario -->
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                <Image Source="user_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Nombre de usuario"
                       Text="{Binding NombreUsuario}"
                       Keyboard="Text"
                       TextColor="#000"
                       PlaceholderColor="#888"
                       BackgroundColor="#fff"
                       HeightRequest="50"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Campo: Email -->
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                <Image Source="email_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Correo electrónico"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       TextColor="#000"
                       PlaceholderColor="#888"
                       BackgroundColor="#fff"
                       HeightRequest="50"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Campo: Contraseña -->
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                <Image Source="lock_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Contraseña"
                       Text="{Binding Contraseña}"
                       IsPassword="True"
                       TextColor="#000"
                       PlaceholderColor="#888"
                       BackgroundColor="#fff"
                       HeightRequest="50"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Campo: Confirmar Contraseña -->
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                <Image Source="lock_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Confirmar contraseña"
                       Text="{Binding ConfirmarContraseña}"
                       IsPassword="True"
                       TextColor="#000"
                       PlaceholderColor="#888"
                       BackgroundColor="#fff"
                       HeightRequest="50"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Botón: Registrar -->
            <Button Text="Registar me"
                    Command="{Binding RegistrarCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,20,0,0">
                   <Button.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                 <GradientStop Color="#007AFF" Offset="0" />
                                 <GradientStop Color="#00C9FF" Offset="1" />
                          </LinearGradientBrush>
                   </Button.Background>
            </Button>

            <!-- Enlace: Iniciar sesión -->
            <Button Text="¿Ya tienes cuenta? Inicia sesión"
                    Command="{Binding IrALoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#007AFF"
                    FontAttributes="Bold"
                    BorderColor="#007AFF"
                    BorderWidth="1"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>