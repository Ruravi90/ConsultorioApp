<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ConsultorioApp.ViewModels"
             x:Class="ConsultorioApp.Views.UsuariosPage"
             Title="Gestión de Usuarios">

    <ScrollView>
        <VerticalStackLayout Padding="20">
            <CollectionView ItemsSource="{Binding Usuarios}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="8" Margin="0,10,0,0">
                            <VerticalStackLayout>
                                <Label Text="{Binding NombreUsuario}" FontAttributes="Bold" />
                                <Label Text="{Binding Rol.Nombre}" />
                                <Button Text="Editar" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:UsuariosViewModel}}, Path=EditarUsuarioCommand}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Nuevo Usuario" 
                    Command="{Binding NuevoUsuarioCommand}" 
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>