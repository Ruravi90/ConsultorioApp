<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ConsultorioApp.ViewModels"
             x:Class="ConsultorioApp.Views.PacienteDetallePage"
             Title="Detalles del Paciente">

    <ScrollView>
        <VerticalStackLayout Padding="20">
            <Entry Placeholder="Nombre" Text="{Binding Paciente.Nombre}" />
            <Entry Placeholder="Apellido" Text="{Binding Paciente.Apellido}" />
            <Entry Placeholder="Teléfono" Text="{Binding Paciente.Telefono}" />
            <DatePicker Date="{Binding Paciente.FechaNacimiento}" Format="d" />

            <Button Text="Guardar" Command="{Binding GuardarCommand}" />
            <Button Text="Cancelar" Command="{Binding CancelarCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>