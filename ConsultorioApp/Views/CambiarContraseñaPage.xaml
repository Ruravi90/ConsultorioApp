<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ConsultorioApp.ViewModels"
             x:DataType="viewmodels:CambiarContraseñaViewModel"
             x:Class="ConsultorioApp.Views.CambiarContraseñaPage"
             Title="Cambiar Contraseña">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Contraseña Actual -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                <Image Source="lock_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Contraseña actual"
                       Text="{Binding ContraseñaActual}"
                       IsPassword="True"
                       BackgroundColor="#FFFFFF"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Nueva Contraseña -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                <Image Source="lock_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Nueva contraseña"
                       Text="{Binding NuevaContraseña}"
                       IsPassword="True"
                       BackgroundColor="#FFFFFF"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Confirmar Contraseña -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                <Image Source="lock_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Confirmar nueva contraseña"
                       Text="{Binding ConfirmarContraseña}"
                       IsPassword="True"
                       BackgroundColor="#FFFFFF"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Botón: Guardar Cambios -->
            <Button Text="Guardar Cambios"
                    Command="{Binding GuardarContraseñaCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,40,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>