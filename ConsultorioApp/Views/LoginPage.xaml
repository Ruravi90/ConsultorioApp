<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ConsultorioApp.ViewModels"
             x:DataType="viewmodels:LoginViewModel"
             x:Class="ConsultorioApp.Views.LoginPage"
             BackgroundColor="#F5F5F5"
             Title="Iniciar Sesión">

    <ContentPage.BindingContext>
        <viewmodels:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="40" VerticalOptions="Center">

            <!-- Logo -->
            <Image Source="logo.png"
                   WidthRequest="100"
                   HeightRequest="100"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Campo de usuario -->
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                <Image Source="user_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Usuario"
                       Text="{Binding NombreUsuario}"
                       Keyboard="Email"
                       TextColor="#000"
                       PlaceholderColor="#888"
                       BackgroundColor="#fff"
                       HeightRequest="50"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Campo de contraseña -->
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto">
                <Image Source="lock_icon.png"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
                <Entry Grid.Column="1"
                       Placeholder="Contraseña"
                       Text="{Binding Contraseña}"
                       IsPassword="True"
                       TextColor="#000"
                       PlaceholderColor="#888"
                       BackgroundColor="#fff"
                       HeightRequest="50"
                       Margin="0,10,0,0" />
            </Grid>

            <!-- Botón de iniciar sesión -->
            <Button Text="Iniciar Sesión"
                    Command="{Binding IniciarSesionCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,20,0,0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#007AFF" Offset="0" />
                        <GradientStop Color="#00C9FF" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <!-- Botón de registro -->
            <Button Text="¿No tienes cuenta? Regístrate"
                    Command="{Binding IrARegistroCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#007AFF"
                    FontAttributes="Bold"
                    BorderColor="#007AFF"
                    BorderWidth="1"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>